# Copie para .env e preencha. O .env não vai para o git.

# ScrapeGraph AI (skill just-scrape): https://scrapegraphai.com/dashboard
SGAI_API_KEY=

# Claude (agente do chat). Vazio = usa o login do Claude Code desta máquina
# (npx @anthropic-ai/claude-code, depois /login). Veja "Conta do Claude" no README.
ANTHROPIC_API_KEY=

# Servidor (opcionais)
# SCRAPE_CHAT_PORT=8787
# SCRAPE_CHAT_MODEL=claude-opus-5-5
# SCRAPE_CHAT_EFFORT=high
# SCRAPE_CHAT_MAX_USD=2      teto de gasto do agente por mensagem
# SCRAPE_CHAT_MAX_TURNS=80
